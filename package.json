{
  "name": "personal-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:pt": "ng serve --configuration development-pt",
    "start:fr": "ng serve --configuration development-fr",
    "build": "ng build",
    "postbuild": "node scripts/postbuild.mjs dist/personal-site/browser",
    "check:dist": "node scripts/check-dist.mjs dist/personal-site/browser",
    "watch": "ng build --watch --configuration development",
    "i18n:extract": "ng extract-i18n",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "test:content": "tsc -p tsconfig.scripts.json && node --test 'scripts/content/*.test.mts'",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@shikijs/markdown-it": "^4.5.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "prettier": "^3.8.1",
    "shiki": "^4.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
