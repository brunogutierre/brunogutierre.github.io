// Turns content/blog/<slug>/<locale>.md into TypeScript the Angular build compiles:
//   src/generated/content/blog.ts                  index of posts per language + lazy loaders
//   src/generated/content/posts/<locale>/<slug>.ts one module per post: its HTML, a lazy chunk
// Usage: node scripts/content/build-content.mts [--drafts]
import { mkdir, readdir, readFile, rm, writeFile } from 'node:fs/promises';
import { join } from 'node:path';
import { parseArgs } from 'node:util';
import { type Frontmatter, parsePost, SLUG } from './frontmatter.mts';
import { createRenderer, readingMinutes } from './markdown.mts';

/**
 * Same list as `LOCALES` in src/app/core/i18n/locale.ts. If they drift, the generated index no
 * longer matches its `Record<Locale, …>` type and the Angular build fails.
 */
export const LOCALES = ['en', 'pt-BR', 'fr'] as const;
export type Locale = (typeof LOCALES)[number];

export interface Post {
  readonly slug: string;
  readonly locale: Locale;
  readonly frontmatter: Frontmatter;
  readonly html: string;
  readonly readingMinutes: number;
}

/** Every problem in the content at once, so one run shows them all. */
export class ContentError extends Error {
  readonly problems: readonly string[];

  constructor(problems: readonly string[]) {
    super(
      `Blog content has ${problems.length} problem(s):\n${problems.map((p) => `- ${p}`).join('\n')}`,
    );
    this.problems = problems;
  }
}

/**
 * Reads, validates and renders every post under `dir`. Drafts are checked like any post, then
 * kept only when `drafts` is set. A missing folder means no posts.
 */
export async function readPosts(dir: string, { drafts }: { drafts: boolean }): Promise<Post[]> {
  const render = await createRenderer();
  const posts: Post[] = [];
  const problems: string[] = [];
  const entries = await readdir(dir, { withFileTypes: true }).catch(() => []);

  for (const entry of entries.toSorted((a, b) => a.name.localeCompare(b.name))) {
    if (entry.name.startsWith('.')) continue;
    if (!entry.isDirectory()) {
      problems.push(`${entry.name}: only post folders belong in content/blog`);
      continue;
    }
    if (!SLUG.test(entry.name)) {
      problems.push(`${entry.name}/: name post folders with lowercase words joined by hyphens`);
      continue;
    }
    const files = (await readdir(join(dir, entry.name))).filter((f) => !f.startsWith('.')).sort();
    if (!files.length) problems.push(`${entry.name}/: no translation in this folder`);

    for (const file of files) {
      const where = `${entry.name}/${file}`;
      const locale = LOCALES.find((l) => file === `${l}.md`);
      if (!locale) {
        problems.push(`${where}: name translations ${LOCALES.map((l) => `${l}.md`).join(', ')}`);
        continue;
      }
      try {
        const { frontmatter, body } = parsePost(await readFile(join(dir, where), 'utf8'));
        const post = { slug: entry.name, locale, frontmatter, html: render(body) };
        posts.push({ ...post, readingMinutes: readingMinutes(body) });
      } catch (error) {
        problems.push(`${where}: ${(error as Error).message.replaceAll('\n', '\n  ')}`);
      }
    }
  }

  if (problems.length) throw new ContentError(problems);
  return drafts ? posts : posts.filter((post) => !post.frontmatter.draft);
}

/** Posts per language, newest first, as the app's `PostSummary` (src/app/core/blog/post.ts). */
export function indexPosts(posts: readonly Post[]) {
  const newestFirst = (a: Post, b: Post) =>
    b.frontmatter.date.localeCompare(a.frontmatter.date) || a.slug.localeCompare(b.slug);
  const summary = ({ slug, frontmatter, readingMinutes }: Post) => ({
    slug,
    title: frontmatter.title,
    description: frontmatter.description,
    date: frontmatter.date,
    ...(frontmatter.updated && { updated: frontmatter.updated }),
    tags: frontmatter.tags,
    readingMinutes,
    locales: LOCALES.filter((l) => posts.some((p) => p.slug === slug && p.locale === l)),
    draft: frontmatter.draft,
  });
  return Object.fromEntries(
    LOCALES.map((locale) => [
      locale,
      posts
        .filter((p) => p.locale === locale)
        .toSorted(newestFirst)
        .map(summary),
    ]),
  ) as Record<Locale, ReturnType<typeof summary>[]>;
}

const HEADER = '// Generated by scripts/content/build-content.mts from content/blog. Do not edit.';

export function indexModule(posts: readonly Post[]): string {
  const index = indexPosts(posts);
  const loaders = LOCALES.map((locale) => {
    const lines = index[locale].map(
      ({ slug }) =>
        `    '${slug}': () => import('./posts/${locale}/${slug}').then((m) => m.default),`,
    );
    return `  '${locale}': {\n${lines.join('\n')}\n  },`;
  });
  return `${HEADER}
import type { PostSummary } from '../../app/core/blog/post';
import type { Locale } from '../../app/core/i18n/locale';

/** Posts per language, newest first. */
export const POSTS: Readonly<Record<Locale, readonly PostSummary[]>> = ${JSON.stringify(index, null, 2)};

/** The HTML of each post: one lazy chunk per post and language. */
export const POST_BODIES: Readonly<Record<Locale, Readonly<Record<string, () => Promise<string>>>>> = {
${loaders.join('\n')}
};
`;
}

export function postModule(post: Post): string {
  return `${HEADER}\nexport default ${JSON.stringify(post.html)};\n`;
}

/** Replaces `outDir` with the index and one module per post. */
export async function writeContent(posts: readonly Post[], outDir: string): Promise<void> {
  await rm(outDir, { recursive: true, force: true });
  for (const locale of LOCALES) await mkdir(join(outDir, 'posts', locale), { recursive: true });
  await writeFile(join(outDir, 'blog.ts'), indexModule(posts));
  for (const post of posts) {
    await writeFile(join(outDir, 'posts', post.locale, `${post.slug}.ts`), postModule(post));
  }
}

if (import.meta.main) {
  const { values } = parseArgs({ options: { drafts: { type: 'boolean', default: false } } });
  const root = join(import.meta.dirname, '..', '..');
  try {
    const posts = await readPosts(join(root, 'content', 'blog'), { drafts: values.drafts });
    await writeContent(posts, join(root, 'src', 'generated', 'content'));
    const drafts = values.drafts ? ', drafts included' : '';
    console.log(`Blog content: ${posts.length} post file(s)${drafts} → src/generated/content`);
  } catch (error) {
    console.error(error instanceof ContentError ? error.message : error);
    process.exitCode = 1;
  }
}
